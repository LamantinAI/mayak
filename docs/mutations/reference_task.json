{
 "subject": "reference_task",
 "about": "Defects planted one at a time in the reference vertical to measure what its tests catch. Each entry is an exact text replacement: `breaks` says what a caller would see, `expect` names the tests written to notice, `mechanism` says how the recorded baseline caught it (direct, indirect, only through an SQL-text pin, only in e2e, or equivalent — nothing observable changes). `baseline` is written by `uv run python scripts/run_mutations.py --record`; compare a later run against it before and after changing the tests. The catalogue belongs to the reference vertical and goes when the vertical goes.",
 "tiers": {
  "fast": [
   "make",
   "test"
  ],
  "e2e": [
   "make",
   "test-e2e"
  ]
 },
 "mutations": [
  {
   "id": "create_blank_title_allowed",
   "kind": "rule",
   "file": "project/application/reference_task_service.py",
   "find": "\n        if not title.strip():",
   "replace": "\n        if False:",
   "breaks": "a blank title is stored instead of answering 422",
   "expect": [
    "test_create_rejects_a_blank_title"
   ],
   "mechanism": "direct"
  },
  {
   "id": "create_title_limit_off_by_one",
