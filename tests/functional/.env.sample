# ==========================================
# PROJECT SETTINGS (Prefix: APP_)
# ==========================================
# Project name
APP_NAME=Mayak
# Debug mode (True/False)
# The functional suite must walk the same paths as production: with APP_DEBUG=true
# Starlette intercepts unhandled exceptions before the application's own handler, and the
# validate_runtime guards do not run.
APP_DEBUG=false
# Sampling rate for probe logging (0.0 - 1.0)
APP_SAMPLING_HEALTH_CHECK_RATE=0.01

# ==========================================
# LLM SETTINGS (Prefix: OPENAI_COMPATIBLE_)
# ==========================================
# API key (may stay empty in mock mode)
OPENAI_COMPATIBLE_API_KEY=
# Base URL (when you use a third-party provider or a local model)
OPENAI_COMPATIBLE_BASE_URL=https://openrouter.ai/api/v1
# Model name
OPENAI_COMPATIBLE_MODEL=qwen/qwen3-next-80b-a3b-instruct

# ==========================================
# SERVER SETTINGS (Prefix: SERVER_)
# ==========================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_WORKERS=1
# Allowed CORS origins (as a JSON list).
# ["*"] must never be left in place for production when APP_DEBUG=false.
SERVER_CORS_ORIGINS=["http://test-app:8000"]

# ==========================================
# POSTGRES SETTINGS (Prefix: POSTGRES_)
# ==========================================
POSTGRES_USER=your_postgres_user
# NOT the root .env.sample placeholder, on purpose. This stack runs with APP_DEBUG=false — that is
# its whole point, it must walk the production paths — and validate_runtime() refuses to start when
# a credential still holds the value .env.sample ships. Carrying the placeholder here made the app
# container exit 1 before the first test ran. The value below is a throwaway: the database it
# authenticates against lives and dies with `make test-e2e`.
POSTGRES_PASSWORD=functional-stack-throwaway
POSTGRES_DB=your_database_name
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_POOL_SIZE=20

# ==========================================
# AGENT SETTINGS (Prefix: AGENT_)
# ==========================================
AGENT_DEFAULT_LLM_TEMPERATURE=0.2
AGENT_MAX_TOKENS=4096
AGENT_MAX_LLM_CALL_RETRIES=3
AGENT_LLM_MODE=mock
AGENT_LLM_READINESS_CHECK_MODE=init
AGENT_LLM_READINESS_TIMEOUT_SECONDS=5.0

# System prompt settings
AGENT_PROMPTS_DIR=project/prompts
AGENT_SYSTEM_PROMPT_NAME=example_assistant_prompt.txt

