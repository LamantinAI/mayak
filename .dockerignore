MANIFEST

# Virtual Environment
# The glob matters: a second interpreter's environment sitting beside .venv used to be copied
# into the image by `COPY . .`, so the build context — and the layer hash — depended on which
# throwaway virtualenvs the author happened to have on disk.
.env
.venv
.venv*
env/
venv/
ENV/
env.bak/
venv.bak/

# IDEs
.idea/
.vscode/
*.swp
*~

# Docker
Dockerfile
docker-compose.yml
.dockerignore

# Logs
logs/
*.log

# Testing and tool caches
# Every entry below is a local artifact the runtime never reads. They were listed in .gitignore
# but not here, so they stayed out of git and went into the image anyway.
.tox/
.nox/
.coverage
coverage.xml
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tiktoken_cache/
