# ==========================================
# PROJECT SETTINGS (Prefix: APP_)
# ==========================================
# Project name
APP_NAME=Mayak
# Debug mode (True/False).
# IMPORTANT: true switches off three validate_runtime() guards at once — the wildcard check on
# SERVER_CORS_ORIGINS, and the placeholder checks on POSTGRES_PASSWORD and
# OPENAI_COMPATIBLE_API_KEY — besides DEBUG-level logs and a single worker. It does NOT hand
# Starlette's traceback page to clients: FastAPI(debug=False) is hard-wired regardless of this
# flag. Keep it false even locally; the startup event names the guards it relaxed when it is not.
APP_DEBUG=false
# Sampling rate for probe logging (0.0 - 1.0)
APP_SAMPLING_HEALTH_CHECK_RATE=0.01
# Directory for local development logs. The file is created only when
# ENABLE_FULL_TRACE=true (see below), NOT when APP_DEBUG=true: the two flags are
# independent, so a stand can collect full traces without turning on debug ergonomics.
APP_LOG_DIR=logs
# Maximum number of log files kept (0 = unlimited)
APP_LOG_MAX_FILES=50

# ==========================================
# LLM SETTINGS (Prefix: OPENAI_COMPATIBLE_)
# ==========================================
# API key. Required only in live mode (AGENT_LLM_MODE=live).
OPENAI_COMPATIBLE_API_KEY=
# Base URL (when you use a third-party provider or a local model)
OPENAI_COMPATIBLE_BASE_URL=https://openrouter.ai/api/v1
# Model name
OPENAI_COMPATIBLE_MODEL=qwen/qwen3-next-80b-a3b-instruct
# The tokenizer model ChatOpenAI uses to count tokens.
OPENAI_COMPATIBLE_TIKTOKEN_MODEL_NAME=gpt-4o-mini
# Timeout of a single provider request, in seconds.
OPENAI_COMPATIBLE_REQUEST_TIMEOUT=60

# ==========================================
# SERVER SETTINGS (Prefix: SERVER_)
# ==========================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_WORKERS=1
# Allowed CORS origins (as a JSON list).
# validate_runtime() rejects a wildcard anywhere in this list when APP_DEBUG=false AND
# SERVER_CORS_ALLOW_CREDENTIALS is true — that pair is the credentialed-wildcard hole, not the
# wildcard on its own. Debug is off here and credentials are on below, so the sample carries a
# concrete origin. Replace it with your own before deploying.
SERVER_CORS_ORIGINS=["http://localhost:8000"]
# Whether CORS responses send Access-Control-Allow-Credentials. Was a hardcoded literal until
# 2026-08-24. Default true keeps existing deployments unchanged; set false to make a wildcard
# SERVER_CORS_ORIGINS the safe, ordinary shape for a public or unauthenticated API. See the
# guard in project/core/config_runtime.py, Settings.validate_runtime.
SERVER_CORS_ALLOW_CREDENTIALS=true

# ==========================================
# DOCKER COMPOSE SETTINGS (no prefix; read directly by docker-compose.yml, not by the app)
# ==========================================
# The host port docker-compose.yml publishes the container's SERVER_PORT on.
# Optional: existing .env files do not need it — when absent, the default 8000 is used.
# Override it to run several stacks/checkouts of this project on one machine at the same time
# (see `docker compose -p <name> up -d` with a different APP_PORT per run).
APP_PORT=8000

# ==========================================
# POSTGRES SETTINGS (Prefix: POSTGRES_)
# ==========================================
# Whether the project uses a relational store. false — the kernel starts with no connection
# pool, runs no migrations, and does not treat the database as critical in /health/ready. For a
# service that needs only vector search, or nothing at all. Details: docs/adr/ADR-006-optional-postgres.md
POSTGRES_ENABLED=true
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=your_database_name
POSTGRES_HOST=localhost
# The port the database is reachable on FROM THE HOST: the application runs locally through
# `make run-local`, and `docker compose` publishes the container's 5432 exactly here. If 5432 is
# taken, pick any free port (`make smoke` defaults to 15432). Inside the network the container
# always listens on 5432, which is why docker-compose.postgres.yml overrides this variable with
# its own value instead of reading it from here.
POSTGRES_PORT=5432
# Upper bound on the number of connections in the shared pool.
POSTGRES_POOL_SIZE=20

# ==========================================
# AGENT SETTINGS (Prefix: AGENT_)
# ==========================================
AGENT_DEFAULT_LLM_TEMPERATURE=0.2
# 4096 matches the code default. 2000 truncates an SSE answer mid-sentence — exactly the bug
# described in the comment next to the default in config_settings_agent.py.
AGENT_MAX_TOKENS=4096
AGENT_MAX_LLM_CALL_RETRIES=3
# LLM service mode: 'mock' (deterministic answers with no network, the default per ADR-003)
# or 'live' (real provider calls through OPENAI_COMPATIBLE_*).
AGENT_LLM_MODE=mock
AGENT_LLM_READINESS_CHECK_MODE=init
AGENT_LLM_READINESS_TIMEOUT_SECONDS=5.0
# Whether an unhealthy LLM check makes /health/ready report unready. The check still runs and
# is still reported either way; only its vote in the verdict is conditional. False by default —
# the shipped vertical never calls the model, and every replica shares one provider. See
# docs/adr/ADR-008-readiness-criticality.md.
AGENT_LLM_READINESS_CRITICAL=false

# System prompt settings
AGENT_PROMPTS_DIR=project/prompts
AGENT_SYSTEM_PROMPT_NAME=example_assistant_prompt.txt


# ==========================================
# DEEP TRACE OBSERVABILITY (Prefix: none; orthogonal to APP_DEBUG)
# ==========================================
# Writes the full pipeline trace to an NDJSON file (`logs/<ts>_pid<PID>.ndjson`):
#  - system_prompt / user_message / completion_text for every LLM call
#  - every semantic agent-flow event
# The file grows in proportion to the number of LLM calls — turn it on only on an eval
# stand or while debugging.
ENABLE_FULL_TRACE=false
