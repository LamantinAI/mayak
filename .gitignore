.DS_Store

# Author-local caches and notes. These were a recurring source of project_map.md drift: git must
# exclude them from `git ls-files --others --exclude-standard` so scripts/structure_builder.py's
# git-index-driven enumeration never sees them.
.tiktoken_cache/
docs/research/


# Local list of words this checkout must not contain. Never committed: the list itself
# would publish exactly what it exists to keep out. See tests/application/test_template_neutrality.py.
.neutrality-terms
