#!/bin/sh
set -e
# Git pre-commit hook to refresh generated AI-facing artifacts and enforce the canonical quality gates.

# Ensure uv is discoverable in non-interactive shells (CI, agent sandboxes).
for candidate in /opt/homebrew/bin /usr/local/bin "$HOME/.local/bin" "$HOME/.cargo/bin"; do
  [ -d "$candidate" ] && export PATH="$candidate:$PATH"
done

if ! command -v uv >/dev/null 2>&1; then
  echo "ERROR: uv not found in PATH. Install: https://docs.astral.sh/uv/getting-started/installation/"
  exit 1
fi

# The gate checks the working tree; git commits the index. A Python file staged and then edited
# again is two files — the gate would pass one and the commit carry the other — so it is refused.
partial=""
for file in $(git diff --cached --name-only --diff-filter=ACMR -- '*.py'); do
  git diff --quiet -- "$file" || partial="$partial $file"
done
if [ -n "$partial" ]; then
  echo "ERROR: staged Python changed again after staging — stage all of it or none:"
  for file in $partial; do echo "  $file"; done
  exit 1
fi

# Run the shared golden-path verification. `make quality-gates` refreshes the generated artifacts
# itself (`refresh-generated-unless-strict`, since this hook does not set STRICT_GENERATED) before
# running the `--check` steps, so a separate `make refresh-agent-docs` call here would
# regenerate the same artifacts a second time for nothing. Python it does not fix: STRICT_RUFF=1,
# because a file the gate rewrote here would be checked and then left out of the commit.
echo "--- Pre-commit: running quality gates ---"
STRICT_RUFF=1 make quality-gates

# Auto-stage refreshed generated files.
# A hand-kept copy of the list here would be exactly what drifts silently: missing even one output
# means a regenerated file is never staged, and the commit goes through green with the generated
# output left behind.
#
# Hand-written files are deliberately absent from this list. Listing one staged whatever the
# author happened to have open, silently, into an unrelated commit. A generated-file hook must
# stage generated files only.
# Read from the Makefile instead of repeating it, which is also where
# `.agents/hooks/pre-edit-guard.sh` reads it, so the three can never disagree.
GENERATED_FILES=$(make -s print-generated-paths)
changed=$(git diff --name-only -- $GENERATED_FILES)
if [ -n "$changed" ]; then
  echo "--- Pre-commit: auto-staging refreshed docs ---"
  echo "$changed" | sed 's/^/  /'
fi
git add $GENERATED_FILES 2>/dev/null || true
